# =====================================================================
# edukoreaiui — Local Environment Variables
# Copy to edukoreaiui/.env.local (or edukoreaiui/.env) and fill in
# real values. Already covered by edukoreaiui/.gitignore — never commit it.
# =====================================================================

# ── BACKEND CONNECTION ────────────────────────────────────────────────
# Base URL of the edukoreaiapi backend this UI talks to over HTTP.
# Point this at your deployed Cloud Run URL for a production/APK build.
API_BASE_URL=http://localhost:8000

# ── APPLICATION SETTINGS ──────────────────────────────────────────────
# Window/app title shown in the UI
APP_TITLE=EduKoreAI
APP_LOGO=resources/edukoreai-logo.ico

# Primary theme color (hex) — used for buttons, headers, gradients
THEME_COLOR=#3949AB

# ── LAUNCH MODE ───────────────────────────────────────────────────────
# desktop = native Flet window; web = open in the default browser
# (use web if Windows Smart App Control blocks the desktop client).
UI_MODE=web
# Port used in web mode (must differ from GOOGLE_OAUTH_PORT)
WEB_PORT=8550

# ── WINDOW CONFIGURATION ──────────────────────────────────────────────
# Desktop window size in pixels (has no effect on mobile/APK builds)
WINDOW_WIDTH=400
WINDOW_HEIGHT=780

# Whether the desktop window can be resized by the user (true/false)
WINDOW_RESIZABLE=true

# Page background color (hex)
BACKGROUND_COLOR=#F5F5F5

# ── GOOGLE OAUTH ────────────────────────────────────────────────────
# Google OAuth 2.0 client ID for desktop app authentication.
# Get this from Google Cloud Console → Credentials → OAuth 2.0 Client ID
# (Must match backend GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# OAuth callback server port (localhost redirects back here after Google auth)
GOOGLE_OAUTH_PORT=8080

# Scopes requested from Google
GOOGLE_OAUTH_SCOPES=openid,https://www.googleapis.com/auth/userinfo.profile,https://www.googleapis.com/auth/userinfo.email
