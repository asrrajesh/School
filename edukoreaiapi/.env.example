# =====================================================================
# edukoreaiapi — Local Environment Variables
# Copy to edukoreaiapi/.env.local (or edukoreaiapi/.env) and fill in
# real values. Never commit this file — it's already covered by
# edukoreaiapi/.gitignore's ".env" entry, but double check.
# =====================================================================

# ── DATABASE (MongoDB) ────────────────────────────────────────────────
# Connection string. Local default shown; for MongoDB Atlas use the
# mongodb+srv://user:pass@cluster.../ form instead.
MONGO_URI=

# Database name the app reads/writes (collections: users, scanned_chapters, questions)
DB_NAME=MySchool

# Server selection timeout in milliseconds before a connection attempt fails
DB_CONNECTION_TIMEOUT=5000

# ── OCR ─────────────────────────────────────────────────────────────────
# Selects the OCR backend used to turn scanned images into text.
# One of: easyocr | llm_vision (llm_vision requires a vision-capable LLM_PROVIDER)
OCR_ENGINE=easyocr
OCR_LANGUAGES=en
OCR_USE_GPU=false

# ── LLM PROVIDER ───────────────────────────────────────────────────────
# Selects the LLM backend used for question generation (and OCR when
# OCR_ENGINE=llm_vision).
# One of: claude | openai | gemini | ollama
LLM_PROVIDER=claude
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0

# ── ANTHROPIC (Claude) ────────────────────────────────────────────────
# Required when LLM_PROVIDER=claude. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for both OCR and question generation
ANTHROPIC_MODEL=

# ── OPENAI ──────────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=openai. Get a key at https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── GOOGLE GEMINI ───────────────────────────────────────────────────────
# Required when LLM_PROVIDER=gemini. Get a key at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ── OLLAMA (local models) ────────────────────────────────────────────────
# Required when LLM_PROVIDER=ollama. Run `ollama serve` locally first.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava
OLLAMA_REQUEST_TIMEOUT=120

# ── SECURITY ───────────────────────────────────────────────────────────
# Minimum password length enforced at signup
PASSWORD_MIN_LENGTH=8

# ── GOOGLE OAUTH ────────────────────────────────────────────────────────
# Google OAuth 2.0 credentials for desktop app authentication.
# Get these from Google Cloud Console → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth scopes requested from Google (user info + email)
GOOGLE_OAUTH_SCOPES=openid,https://www.googleapis.com/auth/userinfo.profile,https://www.googleapis.com/auth/userinfo.email

# ── VALIDATION ─────────────────────────────────────────────────────────
# Regex used to validate usernames as email addresses
EMAIL_PATTERN=^[\w\.\+\-]+@[\w\-]+\.[a-zA-Z]{2,}$

# Regex used to validate usernames as mobile numbers (10–15 digits, optional +)
MOBILE_PATTERN=^\+?[0-9]{10,15}$

# ── SERVER ─────────────────────────────────────────────────────────────
# Host/port uvicorn binds to when run directly via `python main.py`
# (Cloud Run overrides the port via its own $PORT env var — see Dockerfile)
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed CORS origins, or "*" to allow all.
# e.g. CORS_ORIGINS=http://localhost:8550,https://app.example.com
CORS_ORIGINS=*