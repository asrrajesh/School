# =====================================================================
# edukoreaiapi — Local Environment Variables
# Copy to edukoreaiapi/.env.local (or edukoreaiapi/.env) and fill in
# real values. Never commit this file — it's already covered by
# edukoreaiapi/.gitignore's ".env" entry, but double check.
# =====================================================================

# ── DATABASE (MongoDB) ────────────────────────────────────────────────
# Connection string. Local default shown; for MongoDB Atlas use the
# mongodb+srv://user:pass@cluster.../ form instead.
MONGO_URI=

# Database name the app reads/writes (collections: users, scanned_chapters, questions)
DB_NAME=MySchool

# Server selection timeout in milliseconds before a connection attempt fails
DB_CONNECTION_TIMEOUT=5000

# ── ANTHROPIC (Claude) ────────────────────────────────────────────────
# Required for OCR scanning (claude_ocr.py) and question generation
# (claude_questions.py). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for both OCR and question generation
ANTHROPIC_MODEL=

# ── SECURITY ───────────────────────────────────────────────────────────
# Minimum password length enforced at signup
PASSWORD_MIN_LENGTH=8

# ── VALIDATION ─────────────────────────────────────────────────────────
# Regex used to validate usernames as email addresses
EMAIL_PATTERN=^[\w\.\+\-]+@[\w\-]+\.[a-zA-Z]{2,}$

# Regex used to validate usernames as mobile numbers (10–15 digits, optional +)
MOBILE_PATTERN=^\+?[0-9]{10,15}$

# ── SERVER ─────────────────────────────────────────────────────────────
# Host/port uvicorn binds to when run directly via `python main.py`
# (Cloud Run overrides the port via its own $PORT env var — see Dockerfile)
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed CORS origins, or "*" to allow all.
# e.g. CORS_ORIGINS=http://localhost:8550,https://app.example.com
CORS_ORIGINS=*